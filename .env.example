# Options: "mock" or "suno"
# - "mock": Instantly returns fake songs (for testing/development)
# - "suno": Uses real Suno AI API to generate songs
GENERATOR_STRATEGY=mock

# SUNO API (Only needed if GENERATOR_STRATEGY=suno)
# Get your API key from: https://www.sunoapi.org/
SUNO_API_KEY=your_suno_api_key_here

# GOOGLE OAUTH (Required for login)
# Create a Google Cloud project and OAuth 2.0 credentials
# https://console.cloud.google.com/
CLIENT_ID=your_google_client_id_here
CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/

# FRONTEND URL
FRONTEND_URL=http://localhost:5173
